# Generate a unique random value (at least 32 characters) before starting.
LANDKEEP_SECRET=

# Scheduler clock is local to South Africa. Agency reminder windows are configured
# separately in each landlord's reminder settings; new agencies default to day 3.
LANDKEEP_REMINDER_TIMEZONE=Africa/Johannesburg
LANDKEEP_REMINDER_SEND_TIME=08:00
LANDKEEP_PUBLIC_BASE_URL=

# PayFast hosted checkout. Start in Sandbox; use a public HTTPS base URL so
# PayFast can post payment notifications to /api/payments/payfast/notify.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

PAYMENT_PROVIDER=paystack
PAYFAST_MODE=sandbox
PAYFAST_RETURN_URL=http://localhost:5173/pay-rent?payment=return
PAYFAST_CANCEL_URL=http://localhost:5173/pay-rent?payment=cancelled
PAYFAST_NOTIFY_URL=http://localhost:8000/api/payments/payfast/notify
PAYFAST_SPLIT_PAYMENTS_ENABLED=false

MAINTENANCE_AI_TIMEOUT_SECONDS=12
MAINTENANCE_MAX_MESSAGES_PER_CONVERSATION=20
MAINTENANCE_MAX_PHOTOS_PER_CONVERSATION=5
MAINTENANCE_TENANT_DAILY_MESSAGE_LIMIT=30
MAINTENANCE_URGENT_ESCALATION_HOURS=2

# Keep console mode enabled for local development. Set false only after provider
# credentials and approved WhatsApp templates are configured.
LANDKEEP_REMINDER_CONSOLE=true
LANDKEEP_PROVIDER_MAX_ATTEMPTS=3
LANDKEEP_PROVIDER_RETRY_BASE_SECONDS=1
LANDKEEP_PROVIDER_MIN_INTERVAL_SECONDS=0.2

# Live automation. Enable after configuring approved templates and provider credentials.
LANDKEEP_LEASE_REMINDERS=true
# Local-only: simulate reminder delivery and contact verification. Keep false on hosted installs.
LANDKEEP_DEMO_MODE=false
# Public HTTPS API base, including /api if the proxy strips it. Enables email unsubscribe links.
LANDKEEP_NOTIFICATION_PUBLIC_API_URL=
LANDKEEP_REPAIR_FOLLOWUPS=false
# Set to real or log. Blank preserves the legacy sender configuration.
WHATSAPP_MODE=
SMS_MODE=
EMAIL_MODE=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Gemini maintenance chat and photo understanding
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Paystack: server-side secret only. All rent settles to one LandKeep account.
# Set PAYMENT_PROVIDER=paystack to use this checkout.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=http://localhost:5173/pay-rent?payment=return
